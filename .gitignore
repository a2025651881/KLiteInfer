# ---- 构建产物 ----
build/
build_*/
cmake-build-*/
compile_commands.json

# ---- 第三方依赖源码（本地手动放置，不纳入版本控制）----
armadillo/
glog/
googletest/

# 防止第三方源码目录里的 git 元数据被当成嵌套仓库
**/.git/
**/.gitattributes

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store

# ---- Python 工具链缓存 ----
__pycache__/
*.py[cod]
.venv/

# ---- 模型权重与评测中间产物（体积大，不入库）----
*.bin
*.safetensors
*.npy
